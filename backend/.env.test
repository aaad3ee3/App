NODE_ENV=test
LOG_LEVEL=silent
DATABASE_URL=postgres://store:store@localhost:5432/store_test
SESSION_TOKEN_TTL_DAYS=30
TOPUP_EXPIRY_MINUTES=120
TOPUP_AMOUNT_TOLERANCE_LYD=0.001
SMS_WEBHOOK_HMAC_SECRET=test-secret-please-ignore-not-for-prod
SMS_TRUSTED_SENDERS=Libyana,SMSLibyana
RATE_LIMIT_LOGIN_MAX=500
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_REGISTER_MAX=500
RATE_LIMIT_REGISTER_WINDOW_MS=600000
RATE_LIMIT_WEBHOOK_MAX=120
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
CORS_ALLOWED_ORIGINS=

# Auth-flow limits are raised here so unrelated tests don't exhaust a shared per-IP
# bucket (every request in the suite comes from the same address). The limits themselves
# are exercised deliberately in security.test.ts with their own dedicated counts.
OTP_REQUESTS_PER_HOUR=500
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Google sign-in: a placeholder audience so the endpoint is enabled in tests. The
# library that checks tokens against it is mocked in auth-google.test.ts.
GOOGLE_OAUTH_CLIENT_IDS=test-client-id.apps.googleusercontent.com
