# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://store:store@localhost:5432/store_dev

# Sessions
SESSION_TOKEN_TTL_DAYS=30

# Top-up requests
TOPUP_EXPIRY_MINUTES=120
TOPUP_AMOUNT_TOLERANCE_LYD=0.001

# Libyana SMS webhook (shared secret with the SMS-forwarding app on the store's phone)
SMS_WEBHOOK_HMAC_SECRET=change-me-to-a-long-random-secret
SMS_TRUSTED_SENDERS=Libyana,SMSLibyana

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=600000
RATE_LIMIT_WEBHOOK_MAX=120
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000

# Account lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# CORS — comma-separated list of allowed origins (future admin dashboard). Mobile app uses
# bearer tokens and does not send cookies, so it does not need to be in this list.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seed script — first admin account bootstrap (see src/scripts/seed-admin.ts)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password

# Libya Play (gift card supplier) — see src/adapters/giftcards/libyaplay.adapter.ts.
# Not required until the catalog/order module wires this adapter in, but the client is
# already built against it for connectivity testing.
LIBYA_PLAY_BASE_URL=https://api.libyaplay.com/portal
LIBYA_PLAY_API_KEY=
LIBYA_PLAY_EMAIL=

# Plus (SMM/growth supplier) — see src/adapters/smm/plus.adapter.ts. Same status as
# Libya Play above: not required until the catalog/order module wires this adapter in.
PLUS_BASE_URL=https://hamadh.net/api/v2
PLUS_API_KEY=

# Catalog sync (src/modules/catalog/catalog-sync.service.ts)
CATALOG_MARKUP_PERCENT=0.20
# REQUIRED before running a real sync — no sane default for a parallel-market rate exists.
PLUS_USD_TO_LYD_RATE=
