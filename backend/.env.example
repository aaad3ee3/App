# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Number of reverse proxies in front of this process.
# 0 for local development (nothing in front), 1 for the bundled nginx deployment.
# This MUST be accurate: too low and every client behind the proxy looks like 127.0.0.1,
# collapsing all rate limits into one shared bucket; too high and a client can spoof its
# address with its own X-Forwarded-For header and dodge per-IP limits entirely.
# The app refuses to start in production while this is 0.
TRUST_PROXY_HOPS=0

# Largest request body accepted, in bytes. Nothing here is big.
MAX_BODY_BYTES=65536

# Postgres
DATABASE_URL=postgres://store:store@localhost:5432/store_dev

# Sessions
SESSION_TOKEN_TTL_DAYS=30
# Newest N live sessions per account; older ones are revoked on each new sign-in.
MAX_SESSIONS_PER_USER=5

# Top-up requests
TOPUP_EXPIRY_MINUTES=120
TOPUP_AMOUNT_TOLERANCE_LYD=0.001

# Libyana SMS webhook (shared secret with the SMS-forwarding app on the store's phone).
# Anyone who knows this value can credit wallets at will. In production this must be a
# unique random value of at least 32 characters — generate one with:
#   openssl rand -hex 32
SMS_WEBHOOK_HMAC_SECRET=change-me-to-a-long-random-secret
SMS_TRUSTED_SENDERS=Libyana,SMSLibyana

# Rate limiting — global ceiling, then tighter per-endpoint limits.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=600000
RATE_LIMIT_WEBHOOK_MAX=120
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
# Money-moving endpoints are limited per authenticated user rather than per IP, since
# many customers legitimately share one mobile-carrier address.
RATE_LIMIT_ORDER_MAX=10
RATE_LIMIT_ORDER_WINDOW_MS=60000
RATE_LIMIT_TOPUP_MAX=10
RATE_LIMIT_TOPUP_WINDOW_MS=60000
RATE_LIMIT_ADMIN_WRITE_MAX=60
RATE_LIMIT_ADMIN_WRITE_WINDOW_MS=60000

# Account lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# CORS — comma-separated list of allowed browser origins (the admin dashboard). The mobile
# app uses bearer tokens and does not send cookies, so it does not need to be listed.
# Production requires explicit https origins; '*' is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seed script — first admin account bootstrap (see src/scripts/seed-admin.ts).
# Production requires at least 12 characters and rejects the example placeholder.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password

# Libya Play (gift card supplier) — see src/adapters/giftcards/libyaplay.adapter.ts.
LIBYA_PLAY_BASE_URL=https://api.libyaplay.com/portal
LIBYA_PLAY_API_KEY=
LIBYA_PLAY_EMAIL=

# Plus (SMM/growth supplier) — see src/adapters/smm/plus.adapter.ts.
PLUS_BASE_URL=https://hamadh.net/api/v2
PLUS_API_KEY=

# Catalog sync (src/modules/catalog/catalog-sync.service.ts)
CATALOG_MARKUP_PERCENT=0.20
# REQUIRED before running a real sync — no sane default for a parallel-market rate exists.
PLUS_USD_TO_LYD_RATE=
